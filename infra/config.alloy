local.file_match "microservices" {
  path_targets = [
    {"__path__" = "/app/api-gateway/logs/*.log", "service" = "api-gateway"},
    {"__path__" = "/app/contrato-service/logs/*.log", "service" = "contrato-service"},
    {"__path__" = "/app/notificacao-service/logs/*.log", "service" = "notificacao-service"},
    {"__path__" = "/app/reputacao-service/logs/*.log", "service" = "reputacao-service"},
    {"__path__" = "/app/auditoria-service/logs/*.log", "service" = "auditoria-service"},
  ]
}

loki.source.file "microservices" {
  targets    = local.file_match.microservices.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}